# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel staging: set this to the generated https://*.vercel.app origin.
# Production later: https://tourcoin.ma

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ or expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Tourcoin <reservation@tourcoin.ma>
BOOKING_NOTIFICATION_EMAIL=

# Required in Vercel production/staging. Booking fails closed if missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
