{
  "name": "tourcoin",
  "version": "1.0.0",
  "description": "Tourcoin — location de voitures au Maroc",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fleet:reconcile:prepare": "node --env-file=.env.local scripts/reconcile-live-fleet.mjs --prepare",
    "fleet:reconcile:finalize": "node --env-file=.env.local scripts/reconcile-live-fleet.mjs --finalize",
    "fleet:sync-images": "node --env-file=.env.local scripts/sync-fleet-images.mjs",
    "fleet:reconcile": "node --env-file=.env.local scripts/reconcile-live-fleet.mjs",
    "fleet:adilcar:dry-run": "node --env-file=.env.local scripts/import-adilcar-fleet.mjs",
    "fleet:adilcar:apply": "node --env-file=.env.local scripts/import-adilcar-fleet.mjs --apply",
    "fleet:adilcar:rollback": "node --env-file=.env.local scripts/import-adilcar-fleet.mjs --rollback"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
